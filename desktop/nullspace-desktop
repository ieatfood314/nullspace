def now_ms():
    return int(time.time() * 1000)


# ---------------- the hub ----------------

class Hub(QObject):
    """Talks to the hub from a thread of its own. Records waiting to go are
    kept on disk, so a capture made while the hub is away isn't lost."""

    changed = pyqtSignal()           # new records arrived
    filed = pyqtSignal(str)          # a capture of ours came back filed: what it became
    status = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self.lock = threading.Lock()
        self.recs = {}               # (kind, uid) -> record
        self.rev = 0
        self.pending = load_json(STATE / "pending.json", [])
        self.shots = load_json(STATE / "shots.json", [])   # uids whose shot isn't uploaded
        self.mine = set(load_json(STATE / "announce.json", []))  # captures to say the result of
        self.wake = threading.Event()
        self.url = None
        self.wait = 0                # seconds the next sync asks the hub to wait for filing
        threading.Thread(target=self.run, daemon=True).start()

    def put(self, kind, uid, data, shot=None, wait=0):
        rec = {"kind": kind, "uid": uid, "data": data, "updated_at": now_ms(), "deleted": False}
        with self.lock:
            self.recs[(kind, uid)] = rec
            self.pending.append(rec)
            save_json(STATE / "pending.json", self.pending)
            if shot is not None:
                (STATE / "shots").mkdir(parents=True, exist_ok=True)
                (STATE / "shots" / f"{uid}.webp").write_bytes(shot)
                self.shots.append(uid)
                save_json(STATE / "shots.json", self.shots)
            if kind == "capture" and data.get("announce"):
                self.mine.add(uid)
                save_json(STATE / "announce.json", sorted(self.mine))
        self.wait = max(self.wait, wait)
        self.wake.set()

    def items(self):
        with self.lock:
            return [r for (k, _), r in self.recs.items() if k == "item" and not r.get("deleted")]

    def get(self, kind, uid):
        with self.lock:
            return self.recs.get((kind, uid))

    def post(self, path, body, ctype="application/json", timeout=40):
        req = urllib.request.Request(self.url + path, data=body, method="POST",
                                     headers={"Content-Type": ctype,
                                              "User-Agent": "Nullspace-desktop"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")

    def run(self):
        fails = 0
        while True:
            url = hub_url()
            if url != self.url:          # a new hub: start over
                with self.lock:
                    self.recs, self.rev, self.url = {}, 0, url
            try:
                self.sync_once()
                self.status.emit("")
                fails = 0
            except Exception as e:       # whatever it was, the thread must live on
                self.status.emit("Offline")
                log("sync:", e)
                fails += 1
            # Retry soon at first: the hub on this computer may still be starting.
            self.wake.wait(min(SYNC_EVERY_S, 5 * 2 ** (fails - 1)) if fails else SYNC_EVERY_S)
            self.wake.clear()

    def sync_once(self):
        with self.lock:
            out = list(self.pending)
        wait, self.wait = self.wait, 0
        body = {"since": self.rev, "records": out, "device": DEVICE}
        if wait:
            body["wait"] = wait
        got = self.post("/api/sync", json.dumps(body).encode(), timeout=40 + wait)
        with self.lock:
            sent = {id(r) for r in out}
            self.pending = [r for r in self.pending if id(r) not in sent]
            save_json(STATE / "pending.json", self.pending)
            for r in got.get("records") or []:
                key = (r.get("kind"), r.get("uid"))
                old = self.recs.get(key)
                if old is None or (r.get("updated_at") or 0) >= (old.get("updated_at") or 0):
                    self.recs[key] = r
            self.rev = got.get("rev", self.rev)
            shots = list(self.shots)
        for uid in shots:
            f = STATE / "shots" / f"{uid}.webp"
            try:
                if f.exists():
                    self.post(f"/api/shot/{uid}", f.read_bytes(), "image/webp")
                    f.unlink()
            except urllib.error.HTTPError as e:
                if e.code >= 500:
                    raise
                f.unlink(missing_ok=True)   # the hub won't take it; don't retry forever
            with self.lock:
                self.shots.remove(uid)
                save_json(STATE / "shots.json", self.shots)
        self.announce()
        self.changed.emit()

    def announce(self):
        """Say what a voice note became once the hub filed it, as the phone does."""
        with self.lock:
            for uid in list(self.mine):
                c = self.recs.get(("capture", uid))
                if c is None or (c["data"].get("status") or "new") != "done":
                    continue
                self.mine.discard(uid)
                if time.time() - (c["data"].get("created_at") or 0) > 120:
                    continue
                titles = [self.recs[("item", u)]["data"].get("title", "")
                          for u in c["data"].get("items") or [] if ("item", u) in self.recs]
                changed = [ch.get("title") for ch in c["data"].get("changed") or [] if ch.get("title")]
                parts = []
                if titles:
                    parts.append("Added " + ", ".join(titles))
                if changed:
                    parts.append(("changed " if parts else "Changed ") + ", ".join(changed))
                self.filed.emit(", ".join(parts) or "Saved")
            save_json(STATE / "announce.json", sorted(self.mine))


# ---------------- what's on screen ----------------

def take_shot():
    """The screen the pointer is on, as PNG bytes, or None. Spectacle asks
    KWin for it, which lets KDE's own apps take screenshots without asking."""
    fd, path = tempfile.mkstemp(suffix=".png")
    os.close(fd)
    try:
        for mode in ("-m", "-f"):     # current screen, else all of them
            r = subprocess.run(["spectacle", "-b", "-n", mode, "-o", path],
                               capture_output=True, timeout=20)
            if r.returncode == 0 and os.path.getsize(path) > 0:
                return Path(path).read_bytes()
    except (OSError, subprocess.TimeoutExpired) as e:
        log("screenshot:", e)
    finally:
        os.unlink(path)
    return None


def to_webp(png):
    img = QImage.fromData(png)
    if img.isNull():
        return None
    if img.width() > SHOT_W:
        img = img.scaledToWidth(SHOT_W, Qt.TransformationMode.SmoothTransformation)
    buf = QBuffer()
    buf.open(QIODevice.OpenModeFlag.WriteOnly)
    if not img.save(buf, "WEBP", SHOT_QUALITY):
        return None
    return bytes(buf.data())


def a11y_bus_check():
    """Raise unless the accessibility bus takes connections: libatspi
    aborts the whole process when it can't reach it. Same as Squelch's."""
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    addr = bus.call_sync(
        "org.a11y.Bus", "/org/a11y/bus", "org.a11y.Bus", "GetAddress",
        None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 1000,
        None).unpack()[0]
    Gio.DBusConnection.new_for_address_sync(
        addr, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
        | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
        None, None).close_sync(None)


def screen_text(budget_s=1.5):
    """(app name, text) of the focused window, read over accessibility.
    Squelch already keeps accessibility switched on for its edit capture."""
    try:
        import gi
        gi.require_version("Atspi", "2.0")
        from gi.repository import Atspi
    except (ImportError, ValueError):
        return "", ""
    deadline = time.time() + budget_s
    try:
        a11y_bus_check()
        Atspi.init()
        desk = Atspi.get_desktop(0)
        win, app_name = None, ""
        for i in range(desk.get_child_count()):
            app = desk.get_child_at_index(i)
            if app is None:
                continue
            for j in range(app.get_child_count()):
                w = app.get_child_at_index(j)
                if w is not None and w.get_state_set().contains(Atspi.StateType.ACTIVE):
                    win, app_name = w, app.get_name() or ""
                    break
            if win is not None:
                break
        if win is None:
            return "", ""
        out, size, stack, seen = [], 0, [win], 0
        while stack and size < TEXT_MAX and time.time() < deadline and seen < 4000:
            node = stack.pop()
            seen += 1
            try:
                if not node.get_state_set().contains(Atspi.StateType.SHOWING):
                    continue
                t = ""
                if node.get_text_iface() is not None:
                    n = Atspi.Text.get_character_count(node)
                    t = (Atspi.Text.get_text(node, 0, min(n, TEXT_MAX)) or "").replace("￼", "")
                if not t.strip() and node.get_child_count() == 0:
                    t = node.get_name() or ""
                t = t.strip()
                if t and (not out or out[-1] != t):
                    out.append(t)
                    size += len(t) + 1
                kids = [node.get_child_at_index(k) for k in range(min(node.get_child_count(), 400))]
                stack.extend(k for k in reversed(kids) if k is not None)
            except Exception:
                continue
        return app_name, "\n".join(out)[:TEXT_MAX]
    except Exception as e:
        log("screen text:", e)
        return "", ""


# ---------------- the card ----------------

def make_overlay(widget, right, bottom):
    """A layer-shell overlay in the bottom-right corner that never takes
    keyboard focus (the same trick as Squelch's pill). False off Wayland."""
    if QGuiApplication.platformName() != "wayland":
        return False
    try:
        lib = ctypes.CDLL("libLayerShellQtInterface.so.6")
    except OSError:
        return False
    get = lib._ZN12LayerShellQt6Window3getEP7QWindow
    get.restype, get.argtypes = ctypes.c_void_p, [ctypes.c_void_p]
    set_margins = lib._ZN12LayerShellQt6Window10setMarginsERK8QMargins
    set_margins.restype, set_margins.argtypes = None, [ctypes.c_void_p, ctypes.c_void_p]
    widget.winId()
    ptr = get(sip.unwrapinstance(widget.windowHandle()))
    if not ptr:
        return False
    win = sip.wrapinstance(ptr, QObject)
    for prop, value in (("layer", 3), ("anchors", 2 | 8), ("keyboardInteractivity", 0),
                        ("activateOnShow", False), ("wantsToBeOnActiveScreen", True),
                        ("scope", "nullspace-card")):
        win.setProperty(prop, value)
    margins = (ctypes.c_int * 4)(0, 0, right, bottom)
    set_margins(ptr, ctypes.addressof(margins))
    widget._margins = margins
    return True


class Card(QWidget):
    """The screenshot you just took, for a few seconds: hold the key while it
    shows to say something about it. Clicking it keeps it as it is."""

    W = 300

    def __init__(self, on_done):
        super().__init__(None, Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint
                         | Qt.WindowType.Tool | Qt.WindowType.WindowDoesNotAcceptFocus)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating)
        self.on_done = on_done
        self.shot = None             # the pending capture
        self.timer = QTimer(self, singleShot=True)
        self.timer.timeout.connect(lambda: self.finish(None))
        lay = QVBoxLayout(self)
        lay.setContentsMargins(10, 10, 10, 12)
        lay.setSpacing(10)
        self.pic = QLabel(objectName="shot")
        self.pic.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.line = QLabel()
        self.line.setObjectName("line")
        lay.addWidget(self.pic)
        lay.addWidget(self.line)
        self.overlay = make_overlay(self, 24, 24)

    def open(self, shot):
        if self.shot is not None:
            self.finish(None)
        self.shot = shot
        pix = QPixmap()
        pix.loadFromData(shot["png"] or b"")
        if not pix.isNull():
            pix = pix.scaledToWidth(self.W - 22, Qt.TransformationMode.SmoothTransformation)
            if pix.height() > 220:
                pix = pix.copy(0, 0, pix.width(), 220)
        self.pic.setPixmap(pix)
        self.pic.setVisible(not pix.isNull())
        self.line.setText("Hold to add a note")
        self.line.setProperty("live", False)
        self.line.setStyle(self.line.style())
        self.setFixedWidth(self.W)
        self.adjustSize()
        Path(CARD_FILE).write_text(shot["uid"])
        self.show()
        self.timer.start(int(CARD_S * 1000))

    def listening(self, uid):
        if self.shot and self.shot["uid"] == uid:
            # If the note never ends (squelch-ptt died), keep the shot without one.
            self.timer.start(int(NOTE_MAX_S * 1000))
            self.line.setText("Listening")
            self.line.setProperty("live", True)
            self.line.setStyle(self.line.style())

    def finish(self, said):
        shot, self.shot = self.shot, None
        self.timer.stop()
        Path(CARD_FILE).unlink(missing_ok=True)
        self.hide()
        if shot is not None:
            self.on_done(shot, said)

    def mousePressEvent(self, _e):
        self.finish(None)

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(QColor("#1d2731"))
        p.setBrush(QColor(6, 8, 11, 235))
        p.drawRoundedRect(self.rect().adjusted(0, 0, -1, -1), 14, 14)


# ---------------- the window ----------------

class Window(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Nullspace")
        self.setWindowIcon(icon())
        self.resize(1000, 820)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        profile = QWebEngineProfile("nullspace", self)
        profile.setPersistentStoragePath(str(WEB_DATA))
        profile.setCachePath(str(WEB_DATA / "cache"))
        self.view = QWebEngineView(self)
        self.view.setPage(QWebEnginePage(profile, self.view))
        self.view.page().setBackgroundColor(QColor("#000000"))
        self.view.loadFinished.connect(self.loaded)
        lay.addWidget(self.view)
        self.url = None

    def open(self):
        url = hub_url()
        if url != self.url or not self.view.url().isValid():
            self.url = url
            self.view.load(QUrl(url + "/"))
        self.show()
        self.raise_()
        self.activateWindow()

    def loaded(self, ok):
        if ok:
            self.paint_accent()
        else:   # the hub may still be starting: try again while the window shows
            QTimer.singleShot(3000, lambda: self.isVisible() and self.view.reload())

    def paint_accent(self):
        hexc = config()["accent"]
        self.view.page().runJavaScript(f"window.uplinkAccent && uplinkAccent({json.dumps(hexc)})")

    def toggle(self):
        if self.isVisible() and self.isActiveWindow():
            self.hide()
        else:
            self.open()

    def closeEvent(self, e):
        e.ignore()
        self.hide()


def open_page():
    QDesktopServices.openUrl(QUrl(hub_url() + "/"))


# ---------------- settings ----------------

def write_ai_key(key):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if key:
        fd = os.open(LLM_KEY, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(key + "\n")
        HUB_ENV.write_text(f"NULLSPACE_LLM_URL={GROQ_URL}\nNULLSPACE_LLM_MODELS={GROQ_MODELS}\n"
                           f"NULLSPACE_LLM_KEY_FILE={LLM_KEY}\n")
    else:
        LLM_KEY.unlink(missing_ok=True)
        HUB_ENV.unlink(missing_ok=True)


def ai_key_set():
    return LLM_KEY.exists() and LLM_KEY.read_text().strip() != ""


class Settings(QDialog):
    def __init__(self, on_saved):
