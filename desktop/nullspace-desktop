if QWebEngineView is not None:
    class Page(QWebEnginePage):
        """Takes the page's /desktop-app/ links (its Settings button) instead of following them.
        (A custom scheme never gets here: Chromium hands those to the system.)"""
        def __init__(self, profile, parent, on_link):
            super().__init__(profile, parent)
            self.on_link = on_link
            self.caught = False   # Qt reports a refused navigation as a failed load

        def acceptNavigationRequest(self, url, kind, main):
            if url.path().startswith("/desktop-app/"):
                self.caught = True
                what = url.path().removeprefix("/desktop-app/")
                QTimer.singleShot(0, lambda: self.on_link(what))
                return False
            return super().acceptNavigationRequest(url, kind, main)


class Window(QWidget):
    """The hub's page, and Settings (settings.html) in its place when the gear is pressed."""
    def __init__(self, on_settings, bridge):
        super().__init__()
        self.on_settings = on_settings
        self.bridge = bridge
        self.setWindowTitle("Nullspace")
        self.setWindowIcon(icon())
        self.resize(1100, 820)
        self.stack = QStackedLayout(self)
        self.stack.setContentsMargins(0, 0, 0, 0)
        self.profile = QWebEngineProfile("nullspace", self)
        self.profile.setPersistentStoragePath(str(WEB_DATA))
        self.profile.setCachePath(str(WEB_DATA / "cache"))
        self.view = QWebEngineView(self)
        self.view.setPage(Page(self.profile, self.view, self.on_link))
        self.view.page().setBackgroundColor(QColor("#000000"))
        self.view.loadFinished.connect(self.loaded)
        self.stack.addWidget(self.view)
        self.sview = None
        self.url = None

    def settings_view(self):
        if self.sview is None:
            v = QWebEngineView(self)
            page = QWebEnginePage(self.profile, v)
            page.setBackgroundColor(QColor("#000000"))
            channel = QWebChannel(page)
            channel.registerObject("ns", self.bridge)
            page.setWebChannel(channel)
            f = QFile(":/qtwebchannel/qwebchannel.js")   # Qt's own copy, so the page needs no server
            f.open(QIODevice.OpenModeFlag.ReadOnly)
            script = QWebEngineScript()
            script.setSourceCode(bytes(f.readAll()).decode())
            script.setInjectionPoint(QWebEngineScript.InjectionPoint.DocumentCreation)
            script.setWorldId(QWebEngineScript.ScriptWorldId.MainWorld)
            page.scripts().insert(script)
            v.setPage(page)
            v.setHtml(SETTINGS_HTML.read_text(), QUrl.fromLocalFile(str(WEB_DIR) + "/"))
            self.stack.addWidget(v)
            self.sview = v
        return self.sview

    def open(self, settings=False):
        url = hub_url()
        if url != self.url or not self.view.url().isValid():
            self.url = url
            self.view.load(QUrl(url + "/"))
        self.show()
        if settings:
            v = self.settings_view()
            self.stack.setCurrentWidget(v)
            self.bridge.refresh()
            v.page().runJavaScript("window.nsShown && nsShown()")
            v.setFocus()
        elif self.stack.currentWidget() is not self.view:   # opening Nullspace means the list
            self.show_tasks()
        self.raise_()
        self.activateWindow()

    def show_tasks(self):
        self.bridge.stop_learning()
        self.stack.setCurrentWidget(self.view)
        self.view.setFocus()

    def on_link(self, what):
        if what == "settings":
            self.on_settings()

    def loaded(self, ok):
        page = self.view.page()
        if not ok and page.caught:   # the gear's link, not a hub that's down
            page.caught = False
            return
        page.caught = False
        if ok:
            self.view.page().runJavaScript("window.uplinkDesktop && uplinkDesktop()")
            self.paint_accent()
        else:   # the hub may still be starting: try again while the window shows
            QTimer.singleShot(3000, lambda: self.isVisible() and self.view.reload())

    def paint_accent(self):
        hexc = config()["accent"]
        self.view.page().runJavaScript(f"window.uplinkAccent && uplinkAccent({json.dumps(hexc)})")

    def toggle(self):
        if self.isVisible() and self.isActiveWindow():
            self.hide()
        else:
            self.open()

    def closeEvent(self, e):
        e.ignore()
        self.bridge.stop_learning()
        self.hide()


def open_page():
    QDesktopServices.openUrl(QUrl(hub_url() + "/"))


# ---------------- settings ----------------
# One screen, like the phone's: settings.html in the window, talking to this
# side over QWebChannel. Dictation's settings are Squelch's own files, read and
# written with squelch-tray's helpers, so the two can't drift apart.

def first_existing(paths):
    return next((p for p in paths if p.exists()), paths[-1])


SETTINGS_HTML = first_existing([HERE / "settings.html", Path("/usr/lib/nullspace/desktop/settings.html")])
WEB_DIR = first_existing([HERE.parent / "web", Path("/usr/lib/nullspace/web")])
GROQ_QUICK = "qwen/qwen3.8-27b"      # the phone's quick model: tidying and guessing a cut-off start
GROQ_PICK = ["llama-3.3-70b-versatile", "openai/gpt-oss-120b", "moonshotai/kimi-k2-instruct",
             "openai/gpt-oss-20b", "llama-3.1-8b-instant"]   # the phone's Brain.GROQ_MODELS
AUTOSTART = ["nullspace-desktop.service"]   # with Squelch's units (squelch-tray's SERVICES)

_squelch = None


def squelch():
    """squelch-tray loaded as a module, for its settings helpers; None without Squelch."""
    global _squelch
    if _squelch is None:
        _squelch = False
        path = os.environ.get("NULLSPACE_SQUELCH_TRAY") or shutil.which("squelch-tray")
        if path:
            try:
                from importlib.machinery import SourceFileLoader
                import importlib.util as iu
                loader = SourceFileLoader("squelch_tray", path)
                mod = iu.module_from_spec(iu.spec_from_loader("squelch_tray", loader))
                loader.exec_module(mod)
                _squelch = mod
            except Exception as e:
                log("can't load squelch-tray:", e)
    return _squelch or None


def ai_key():
    try:
        return LLM_KEY.read_text().strip()
    except OSError:
        return ""


def ai_key_set():
    return ai_key() != ""


def ai_conf():
    a = config().get("ai")
    a = a if isinstance(a, dict) else {}
    return {"preset": "other" if a.get("preset") == "other" else "groq",
            "url": str(a.get("url") or ""), "model": str(a.get("model") or "")}


def ai_url(a):
    if a["preset"] == "groq":
        return GROQ_URL
    u = a["url"].strip()
    return u if not u or "://" in u else "https://" + u


def ai_on(a):
    return bool(ai_url(a)) and (ai_key_set() or a["preset"] == "other")


def ai_name(a):
    if a["preset"] == "groq":
        return "Groq"
    try:
        return urllib.parse.urlparse(ai_url(a)).hostname or "Your server"
    except ValueError:
        return "Your server"


def ai_check(a):
    """None if the key works, else a few words on what's wrong. Picks a Groq model
    the key can use, as the phone does."""
    if not ai_on(a):
        return "Add a key"
    base = re.sub(r"/chat/completions/?$", "", ai_url(a))
    headers = {"User-Agent": "Nullspace-desktop"}
    if ai_key():
        headers["Authorization"] = "Bearer " + ai_key()
    try:
        with urllib.request.urlopen(urllib.request.Request(base + "/models", headers=headers), timeout=15) as r:
            have = [m.get("id") for m in json.loads(r.read() or b"{}").get("data") or [] if isinstance(m, dict)]
    except urllib.error.HTTPError as e:
        return "Key didn't work" if e.code in (401, 403) else f"Error {e.code}"
    except (OSError, ValueError):
        return "Can't reach it"
    if a["preset"] == "groq" and have and (a["model"] or GROQ_PICK[0]) not in have:
        a["model"] = next((m for m in GROQ_PICK if m in have), have[0])
    return None


def write_ai(a):
    """The hub on this computer files with it (hub.env), and dictation guesses
    cut-off starts with it (Squelch's llm-fast.json, unless that's someone else's)."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    key = ai_key()
    url = ai_url(a)
    groq = a["preset"] == "groq"
    model = a["model"] or (GROQ_PICK[0] if groq else "")
    sq = squelch()
    fast = Path(sq.CONFIG_DIR) / "llm-fast.json" if sq else None   # squelch-ptt's LLM_FAST_FILE
    ours = False
    if fast is not None:
        cur = load_json(fast, {})
        ours = not fast.exists() or os.path.expanduser(str(cur.get("key_file", ""))) == str(LLM_KEY)
    if not ai_on(a) or not model:
        HUB_ENV.unlink(missing_ok=True)
        if fast is not None and ours:
            fast.unlink(missing_ok=True)
        return
    lines = [f"NULLSPACE_LLM_URL={url}", f"NULLSPACE_LLM_MODELS={model}"]
    if key:
        lines.append(f"NULLSPACE_LLM_KEY_FILE={LLM_KEY}")
    if groq:
        lines += [f"NULLSPACE_FAST_LLM_URL={GROQ_URL}", f"NULLSPACE_FAST_LLM_MODEL={GROQ_QUICK}",
                  f"NULLSPACE_FAST_LLM_KEY_FILE={LLM_KEY}"]
    HUB_ENV.write_text("\n".join(lines) + "\n")
    if fast is not None and ours and key:
        save_json(fast, {"url": re.sub(r"/chat/completions/?$", "", url), "key_file": str(LLM_KEY),
                         "model": GROQ_QUICK if groq else model})


def save_ai_key(key):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if key:
        fd = os.open(LLM_KEY, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(key + "\n")
    else:
        LLM_KEY.unlink(missing_ok=True)


def ago(t):
    s = time.time() - t
    if s < 60:
        return "Synced just now"
    if s < 3600:
        return f"Synced {int(s // 60)} min ago"
    if s < 86400:
        return f"Synced {int(s // 3600)} h ago"
    return f"Synced {int(s // 86400)} d ago"


def first_line(path):
    try:
        with open(path) as f:
            return f.readline().strip()
    except OSError:
        return ""


def write_line(path, text):
    if text:
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        Path(path).write_text(text + "\n")
    else:
        Path(path).unlink(missing_ok=True)


def model_name(sq, engine, label):
    label = label.removeprefix("ggml-").removesuffix(".bin")
    return f"{sq.ENGINE_NAMES.get(engine, engine.title())} {label}"


class Bridge(QObject):
    """What settings.html sees as `ns`. refresh() gathers everything off the Qt
    thread and sends it back as one JSON state; call() changes one thing."""
    state = pyqtSignal(str)
    again = pyqtSignal()

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.busy = {}       # slow jobs running: "access", "download" (its name), "check"
        self.notes = {}      # their short results: "key", "download", "ai"
        self.capture = None  # squelch-tray's KeyCapture while learning the key
        self.lock = threading.Lock()
        self.running = self.queued = False
        self.mics = (0.0, [])
        self.stats = (None, None)
        self.again.connect(self.refresh)

    # --- reading ---
    @pyqtSlot()
    def refresh(self):
        w = self.app.window  # the page polls even when hidden: only work while it shows
        if w is None or not w.isVisible() or w.sview is None or w.stack.currentWidget() is not w.sview:
            return
        sq = squelch()       # loaded here, on the Qt thread, before any worker uses it
        with self.lock:
            if self.running:
                self.queued = True
                return
            self.running = True

        def work():
            try:
                try:
                    s = self.collect(sq)
                except Exception as e:   # a broken file mustn't leave the page empty
                    log("settings:", e)
                    s = self.collect(None)
                self.state.emit(json.dumps(s))
            except Exception as e:
                log("settings:", e)
            finally:
                with self.lock:
                    self.running = False
                    queued, self.queued = self.queued, False
                if queued:
                    self.again.emit()
        threading.Thread(target=work, daemon=True).start()

    def collect(self, sq):
        c = config()
        a = ai_conf()
        hub = self.app.hub
        if hub.failed:
            hub_status = hub.failed if c["hub"].strip() else "Starting"
        elif not c["hub"].strip():
            hub_status = "This computer"
        else:
            hub_status = ago(hub.last_ok) if hub.last_ok else "Not yet"
        s = {"accent": c["accent"], "accents": ACCENTS, "hub": c["hub"], "hubStatus": hub_status,
             "reminders": bool(c["reminders"]),
             "ai": {**a, "on": ai_on(a), "name": ai_name(a), "hasKey": ai_key_set(),
                    "checking": "check" in self.busy, "error": self.notes.get("ai", "")},
             "dictation": None}
        if sq is None:
            return s
        engine = sq.read_engine()
        chosen = sq.read_engine_models()
        models = []
        for _id, eng, label, path, size in sq.model_catalog():
            models.append({"id": _id, "engine": eng, "path": path, "name": model_name(sq, eng, label),
                           "size": size, "here": os.path.exists(path)})
        listed = {m["path"] for m in models}
        for eng in ("parakeet", "whisper"):
            for name, mb, path in sq.list_model_files(eng):
                if path not in listed:
                    models.append({"id": None, "engine": eng, "path": path, "name": model_name(sq, eng, name),
                                   "size": f"{mb:.0f} MB", "here": True})
        for m in models:
            m["inUse"] = m["engine"] == engine and chosen.get(engine) == m["path"]
        current = next((m for m in models if m["inUse"]), None)
        now = time.time()
        if now - self.mics[0] > 20:
            self.mics = (now, sq.list_mics())
        words = sq.load_dict()
        state = load_json(Path(sq.CONFIG_DIR) / "sync-state.json", {})
        sync = first_line(Path(sq.CONFIG_DIR) / "sync")
        units = [u for u, _t in sq.SERVICES] + AUTOSTART
        s["dictation"] = {
            "access": "waiting" if "access" in self.busy else sq.keyboard_access(),
            "mic": sq.read_mic(), "mics": self.mics[1],
            "engine": engine, "engineStatus": sq.engine_status(),
            "model": current["name"] if current else "", "models": models,
            "downloading": self.busy.get("download"), "dlError": self.notes.get("download", ""),
            "headroom": sq.read_headroom_gb(), "longest": sq.longest_dictation() if engine == "parakeet" else "",
            "key": sq.trigger_label(), "learning": self.capture is not None and self.capture.active,
            "keyNote": self.notes.get("key", ""),
            "insert": sq.read_insertion(), "live": sq.read_live(), "filters": sq.read_filters(),
            "sync": sync, "syncStatus": (ago(state["synced"]) if sync and state.get("synced") else
                                         "Not yet" if sync else "Off"),
            "words": [{"term": w["term"], "heard": w["also_match"]} for w in words],
            "pending": sq.pending_mishearings(words),
            "archive": first_line(Path(sq.CONFIG_DIR) / "archive"),
            "autostart": all(en for _a, en in sq.service_states(units).values()),
        }
        s["dictation"].update(self.read_stats(sq))
        return s

    def read_stats(self, sq):
        d = Path(sq.CONFIG_DIR)
        stamp = []
        for p in [d / "stats.jsonl", *sorted((d / "stats.d").glob("*.jsonl"))]:
            try:
                stamp.append((p.name, p.stat().st_mtime))
            except OSError:
                pass
        if self.stats[0] != stamp:
            rows = sq.load_stats()
            me = os.uname().nodename.split(".")[0]
            mine = [r for r in rows if r.get("outcome") == "ok" and r.get("device") == me]
            out = {"stats": sq.summarize_stats(rows) if rows else None,
                   "lastWait": float(mine[-1].get("transcribe_s", 0)) if mine else None}
            self.stats = (stamp, out)
        return self.stats[1]

    # --- changing ---
    @pyqtSlot(str, str, result=str)
    def call(self, name, arg):
        try:
            v = json.loads(arg) if arg else None
        except ValueError:
            v = None
        fn = getattr(self, "do_" + name, None)
        if fn is None:
            return "no such setting"
        try:
            fn(v)
        except Exception as e:
            log("settings:", name, e)
            return str(e)
        self.refresh()
        return ""

    def job(self, key, fn, label=True):
        """Run fn off the Qt thread with self.busy[key] set; a fresh state when it's done."""
        self.busy[key] = label

        def work():
            try:
                fn()
            except Exception as e:
                log("settings:", key, e)
            finally:
                self.busy.pop(key, None)
                self.again.emit()
        threading.Thread(target=work, daemon=True).start()

    def set_config(self, **kv):
        c = config()
        c.update(kv)
        save_json(CONFIG, c)
        self.app.saved()

    def do_back(self, _v):
        self.app.window.show_tasks()

    def do_web(self, v):
        if str(v).startswith("https://"):
            QDesktopServices.openUrl(QUrl(str(v)))

    def do_accent(self, v):
        c = str(v or "").strip().upper()
        c = c if c.startswith("#") else "#" + c
        if len(c) == 7 and QColor(c).isValid():
            self.set_config(accent=c)

    def do_reminders(self, v):
        self.set_config(reminders=bool(v))

    def do_hub(self, v):
        self.set_config(hub=str(v or "").strip())
        self.app.hub.failed = ""
        ensure_local_hub()

    def do_ai(self, v):
        a = ai_conf()
        a.update({k: str(v.get(k) or "").strip() for k in ("preset", "url", "model") if k in v})
        a["preset"] = "other" if a["preset"] == "other" else "groq"
        if "key" in v:
            save_ai_key(str(v["key"] or "").strip())
        self.notes.pop("ai", None)

        def check():
            err = ai_check(a) if ai_on(a) else None
            c = config()
            c["ai"] = a
            save_json(CONFIG, c)
            write_ai(a)
            if err:
                self.notes["ai"] = err
            if not config()["hub"].strip():
                systemctl("restart", HUB_UNIT)
        self.job("check", check)

    def do_access(self, _v):
        self.job("access", lambda: squelch().grant_keyboard_access())

    def do_mic(self, v):
        squelch().write_mic(str(v or ""))

    def do_model(self, v):
        sq = squelch()
        path, engine = v["path"], v["engine"]

        def use():
            models = sq.read_engine_models()
            models[engine] = path
            sq.write_engine_models(models)
            sq.write_engine(engine)
        if os.path.exists(path):
            use()
            return
        if self.busy.get("download") or not v.get("id"):
            return
        self.notes.pop("download", None)

        def fetch():
            r = subprocess.run([sq.setup_models_cmd(), v["id"]], capture_output=True, text=True, timeout=3600)
            if r.returncode == 0 and os.path.exists(path):
                use()
            else:
                err = (r.stderr.strip().splitlines() or ["error"])[-1]
                self.notes["download"] = "Download failed: " + err[:80]
        self.job("download", fetch, v.get("name") or "model")

    def do_headroom(self, v):
        squelch().write_headroom_gb(max(0.0, min(16.0, float(v))))

    def do_learn(self, _v):
        sq = squelch()
        if self.capture is not None and self.capture.active:
            self.capture.stop()
            return
        self.notes.pop("key", None)

        def got(code):
            if code == sq.ESC:
                self.again.emit()
                return

            def apply():   # the row shows the new key; only trouble needs words
                ok, msg = sq.apply_hotkey(code)
                if not ok or msg.startswith("Saved"):
                    self.notes["key"] = msg
            self.job("key", apply)
        self.capture = sq.KeyCapture(got)
        self.capture.start()

    def stop_learning(self):
        if self.capture is not None:
            self.capture.stop()

    def do_insert(self, v):
        squelch().write_insertion(mode=str(v))

    def do_live(self, v):
        squelch().write_insertion(live=bool(v))

    def do_filters(self, v):
        sq = squelch()
        f = sq.read_filters()
        f.update({k: bool(v[k]) for k in ("defiller", "numbers", "numbers_all") if k in v})
        sq.write_filters(f)

    def do_sync(self, v):
        sq = squelch()
        write_line(Path(sq.CONFIG_DIR) / "sync", str(v or "").strip())
        if v:
            systemctl("start", "--no-block", "squelch-sync.service")

    def do_archive(self, v):
        write_line(Path(squelch().CONFIG_DIR) / "archive", str(v or "").strip())

    def do_add_word(self, v):
        sq = squelch()
        term = str(v.get("term") or "").strip()
        heard = [h.strip() for h in v.get("heard") or [] if h.strip()]
        if not term:
            return

        def change(entries):
            e = sq.find_entry(entries, term)
            if e is None:
                entries.append({"term": term, "also_match": heard})
            else:
                e["also_match"] += [h for h in heard if h.lower() not in {x.lower() for x in e["also_match"]}]
        sq.update_dict(change)

    def do_remove_word(self, v):
        sq = squelch()

        def change(entries):
            entries[:] = [e for e in entries if e["term"].lower() != str(v).lower()]
        sq.update_dict(change)

    def do_mishearing(self, v):
        squelch().resolve_mishearing(v["term"], v["heard"], bool(v["accept"]))

    def do_autostart(self, v):
        sq = squelch()
        on = bool(v)

        def run():   # turning it off leaves what's running alone, so dictation keeps working now
            for u in [u for u, _t in sq.SERVICES] + AUTOSTART:
                if on and u not in AUTOSTART:
                    sq.set_service_enabled(u, True, is_self=u == "squelch-tray.service")
                else:
                    systemctl("enable" if on else "disable", u)
        self.job("autostart", run)


