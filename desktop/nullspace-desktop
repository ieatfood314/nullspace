        lay.setSpacing(10)

        lay.addWidget(self.head("Hub"))
        self.here = QRadioButton("This computer")
        self.there = QRadioButton("Another computer")
        g = QButtonGroup(self)
        g.addButton(self.here)
        g.addButton(self.there)
        self.addr = QLineEdit(placeholderText="http://your-hub:4645")
        lay.addWidget(self.here)
        lay.addWidget(self.there)
        lay.addWidget(self.addr)
        self.there.toggled.connect(self.refresh)

        self.ai_head = self.head("AI key")
        lay.addWidget(self.ai_head)
        row = QHBoxLayout()
        self.key = QLineEdit(placeholderText="gsk_…", echoMode=QLineEdit.EchoMode.Password)
        get = QPushButton("Get a key")
        get.clicked.connect(lambda: QDesktopServices.openUrl(QUrl(GROQ_KEYS)))
        row.addWidget(self.key, 1)
        row.addWidget(get)
        self.ai_row = QWidget()
        self.ai_row.setLayout(row)
        row.setContentsMargins(0, 0, 0, 0)
        lay.addWidget(self.ai_row)

        lay.addWidget(self.head("Accent"))
        sw = QHBoxLayout()
        sw.setSpacing(8)
        self.swatches = []
        for c in ACCENTS:
            b = QPushButton(objectName="swatch", checkable=True)
            b.setFixedSize(28, 28)
            b.setProperty("hex", c)
            b.setStyleSheet(f"QPushButton#swatch {{ background: {c}; }}")
            b.clicked.connect(lambda _=False, c=c: self.pick(c))
            sw.addWidget(b)
            self.swatches.append(b)
        self.hex = QLineEdit(maxLength=7)
        self.hex.setFixedWidth(84)
        self.hex.textEdited.connect(lambda t: self.pick(t, typed=True))
        sw.addStretch(1)
        sw.addWidget(self.hex)
        lay.addLayout(sw)

        self.remind = QCheckBox("Reminders on this computer")
        lay.addSpacing(6)
        lay.addWidget(self.remind)

        lay.addSpacing(10)
        bottom = QHBoxLayout()
        dict_btn = QPushButton("Dictation")
        dict_btn.clicked.connect(open_dictation)
        save = QPushButton("Save", objectName="primary", default=True)
        save.clicked.connect(self.save)
        bottom.addWidget(dict_btn)
        bottom.addStretch(1)
        bottom.addWidget(save)
        lay.addLayout(bottom)

    @staticmethod
    def head(text):
        h = QLabel(text, objectName="head")
        return h

    def load(self):
        c = config()
        (self.there if c["hub"].strip() else self.here).setChecked(True)
        self.addr.setText(c["hub"])
        self.key.clear()
        self.key.setPlaceholderText("Saved" if ai_key_set() else "gsk_…")
        self.pick(c["accent"])
        self.remind.setChecked(bool(c["reminders"]))
        self.refresh()

    def refresh(self):
        there = self.there.isChecked()
        self.addr.setVisible(there)
        self.ai_head.setVisible(not there)
        self.ai_row.setVisible(not there)
        self.adjustSize()

    def pick(self, c, typed=False):
        c = c.strip().upper()
        if not c.startswith("#"):
            c = "#" + c
        if len(c) != 7 or not QColor(c).isValid():
            return
        self.accent = c
        for b in self.swatches:
            b.setChecked(b.property("hex").upper() == c)
        if not typed:
            self.hex.setText(c)
        self.setStyleSheet(style(c))

    def save(self):
        c = config()
        c["hub"] = self.addr.text().strip() if self.there.isChecked() else ""
        c["accent"] = getattr(self, "accent", c["accent"])
        c["reminders"] = self.remind.isChecked()
        save_json(CONFIG, c)
        key = self.key.text().strip()
        if not c["hub"] and key:
            write_ai_key(key)
            systemctl("restart", HUB_UNIT)
        ensure_local_hub()
        self.on_saved()
        self.close()


def open_dictation():
    """The dictation settings (Squelch's engine), in the tray that's running if there is one."""
    try:
        subprocess.Popen(["squelch-tray", "--settings"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        notify("Dictation isn't installed", "Reinstall the nullspace package.")


