# ---------------- notifications ----------------

def notify(title, body="", actions=(), on_action=None):
    """A desktop notification. With actions, waits (off the Qt thread) for
    one to be clicked and calls on_action with its key."""
    cmd = ["notify-send", "--app-name=Nullspace", "--icon=nullspace", "--", title]
    if body:
        cmd.append(body)
    if not actions:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    for key, label in actions:
        cmd.insert(1, f"--action={key}={label}")

    def wait():
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=3600).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            return
        if out and on_action:
            on_action(out)
    threading.Thread(target=wait, daemon=True).start()


# ---------------- the app ----------------

class App(QObject):
    shot_ready = pyqtSignal(dict)
    action = pyqtSignal(str, str)     # a notification button: (key, item uid)

    def __init__(self, qapp):
        super().__init__()
        self.qapp = qapp
        self.hub = Hub()
        self.window = Window() if QWebEngineView else None
        self.card = Card(self.commit_shot)
        self.settings = Settings(self.saved)
        self.fired = load_json(STATE / "fired.json", {})
        self.started = time.time()
        self.taking = False

        self.tray = QSystemTrayIcon(icon())
        self.tray.setToolTip("Nullspace")
        menu = QMenu()
        for text, fn in (("Open Nullspace", self.open), ("Capture screen", lambda: QTimer.singleShot(400, self.capture)),
                         (None, None), ("Dictation", open_dictation), ("Settings", self.open_settings),
                         (None, None), ("Quit", qapp.quit)):
            if text is None:
                menu.addSeparator()
            else:
                a = QAction(text, menu)
                a.triggered.connect(fn)
                menu.addAction(a)
        self.menu = menu
        self.tray.setContextMenu(menu)
        self.tray.activated.connect(self.on_tray)
        self.tray.show()

        self.shot_ready.connect(self.card.open)
        self.action.connect(self.on_action)
        self.hub.filed.connect(lambda text: notify(text))
        self.hub.status.connect(lambda s: self.tray.setToolTip("Nullspace" + (f": {s}" if s else "")))
        self.remind_timer = QTimer(self)
        self.remind_timer.timeout.connect(self.remind)
        self.remind_timer.start(15000)
        self.hub.changed.connect(self.remind)
        self.restyle()

        self.server = QLocalServer(self)
        QLocalServer.removeServer(SOCKET)
        if not self.server.listen(SOCKET):
            log("can't listen on", SOCKET, self.server.errorString())
        self.server.newConnection.connect(self.on_connection)
        Path(CARD_FILE).unlink(missing_ok=True)
        qapp.aboutToQuit.connect(self.cleanup)

    def cleanup(self):
        self.server.close()
        Path(CARD_FILE).unlink(missing_ok=True)
        try:
            os.unlink(SOCKET)
        except OSError:
            pass

    def restyle(self):
        self.qapp.setStyleSheet(style(config()["accent"]))

    def saved(self):
        self.restyle()
        if self.window is not None:
            self.window.url = None
            if self.window.isVisible():
                self.window.open()
            self.window.paint_accent()
        self.hub.wake.set()

    def on_tray(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self.window.toggle() if self.window else open_page()

    def open(self):
        self.window.open() if self.window else open_page()

    def open_settings(self):
        self.settings.load()
        self.settings.show()
        self.settings.raise_()
        self.settings.activateWindow()

    # --- squelch-ptt's messages ---
    def on_connection(self):
        while self.server.hasPendingConnections():
            conn = self.server.nextPendingConnection()
            buf = QByteArray()

            def read(conn=conn, buf=buf):
                buf.append(conn.readAll())
                while b"\n" in bytes(buf):
                    raw = bytes(buf)
                    line, rest = raw.split(b"\n", 1)
                    buf.clear()
                    buf.append(rest)
                    self.on_message(line.decode(errors="replace").strip())
            conn.readyRead.connect(read)
            conn.disconnected.connect(conn.deleteLater)

    def on_message(self, line):
        cmd, _, arg = line.partition(" ")
        try:
            data = json.loads(arg) if arg else {}
        except ValueError:
            data = {}
        if cmd == "capture":
            self.capture()
        elif cmd == "open":
            if self.card.shot is not None:
                self.card.finish(None)
            self.open()
        elif cmd == "settings":
            self.open_settings()
        elif cmd == "note-start":
            if data.get("about"):
                self.card.listening(data["about"])
        elif cmd == "note-end":
            self.note(data.get("about"), (data.get("text") or "").strip())

    # --- captures ---
    def capture(self):
        if self.card.shot is not None:   # a press while the card shows keeps it as it is
            self.card.finish(None)
            return
        if self.taking:
            return
        self.taking = True

        def work():
            try:
                got = {}
                reader = threading.Thread(target=lambda: got.update(t=screen_text()), daemon=True)
                reader.start()
                png = take_shot()
                reader.join(3)
                app_name, text = got.get("t", ("", ""))
                shot = {"uid": secrets.token_hex(8), "png": png, "webp": to_webp(png) if png else None,
                        "app": app_name, "text": text, "at": int(time.time())}
                if png is None and not text:
                    notify("Couldn't capture the screen", "Is Spectacle installed?")
                    return
                self.shot_ready.emit(shot)
            finally:
                self.taking = False
        threading.Thread(target=work, daemon=True).start()

    def commit_shot(self, shot, said):
        d = {"type": "screenshot", "status": "new", "created_at": shot["at"], "app": shot["app"],
             "screen_text": shot["text"], "image": shot["webp"] is not None, "device": "desktop"}
        if said:
            d.update(text=said, voice=True, announce=True)
        self.hub.put("capture", shot["uid"], d, shot=shot["webp"], wait=20 if said else 0)

    def note(self, about, text):
        if about and self.card.shot is not None and self.card.shot["uid"] == about:
            self.card.finish(text or None)
            return
        if not text:
            return
        self.hub.put("capture", secrets.token_hex(8),
                     {"type": "voice", "status": "new", "created_at": int(time.time()), "text": text,
                      "device": "desktop", "announce": True}, wait=20)

    # --- reminders ---
    def remind(self):
        if not config()["reminders"]:
            return
        now = time.time()
        for r in self.hub.items():
            d = r["data"]
            at = d.get("remind_at") or 0
            if not at or d.get("type") == "note" or d.get("done_at"):
                continue
            key = f"{r['uid']}:{at}"
            if key in self.fired or at > now or now - at > REMIND_LATE_S:
                continue
            self.fired[key] = int(now)
            title = d.get("title") or "Reminder"
            uid = r["uid"]
            notify(title, d.get("notes") or "", actions=(("done", "Done"), ("open", "Open")),
                   on_action=lambda k, uid=uid: self.action.emit(k, uid))
        if len(self.fired) > 500:
            self.fired = dict(sorted(self.fired.items(), key=lambda kv: kv[1])[-300:])
        save_json(STATE / "fired.json", self.fired)

    def on_action(self, key, uid):
        if key == "open":
            self.open()
        elif key == "done":
            r = self.hub.get("item", uid)
            if r is not None and not r["data"].get("done_at"):
                self.hub.put("item", uid, {**r["data"], "done_at": int(time.time())})


def tell_running(msg):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(SOCKET)
            s.sendall(msg.encode() + b"\n")
        return True
    except OSError:
        return False


def main():
    args = sys.argv[1:]
    msg = "settings" if "--settings" in args else "capture" if "--capture" in args else "open"
    # A second start (the app menu) opens the window of the one running.
    if tell_running("ping" if "--background" in args else msg):
        return
    os.environ.setdefault("QT_QPA_PLATFORM", "wayland;xcb")
    qapp = QApplication(sys.argv)
    qapp.setApplicationName("Nullspace")
    qapp.setDesktopFileName("nullspace")
    qapp.setQuitOnLastWindowClosed(False)
    qapp.setWindowIcon(icon())
    ensure_local_hub()
    app = App(qapp)
    if "--background" not in args:
        QTimer.singleShot(0, {"settings": app.open_settings, "capture": app.capture}.get(msg, app.open))
    if not systemctl("is-active", "--quiet", "squelch-ptt") and shutil.which("squelch-tray"):
        if not (STATE / "asked-setup").exists():
            STATE.mkdir(parents=True, exist_ok=True)
            (STATE / "asked-setup").touch()
            open_dictation()
    sys.exit(qapp.exec())


if __name__ == "__main__":
    main()
